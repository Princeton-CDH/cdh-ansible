{
  "name": "cdh-ansible",
  "packages": [
    "python@3.12",
    "uv@0.12.5",
    "git@2.55.0",
    "gnumake@4.4.1",
    "openssh@latest",
    "rsync@3.5.0",
    "bash@latest",

    "podman@5.8.6",
    "podman-compose@0.1.8",
    "docker-client@29.7.2"
  ],
  "shell": {
    "init_hook": [
      "bash -lc './bin/devbox-init'"
    ],
    "scripts": {
      "sync": "uv sync",
      "lint": "uv run ansible-lint . && uv run yamllint .",
      "molecule": "uv run molecule",
      "pre-commit": "uv run pre-commit run --all-files"
    }
  }
}

