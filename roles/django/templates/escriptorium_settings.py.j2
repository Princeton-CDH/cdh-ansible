{% extends 'local_settings.py.j2' %}
{% block head %}
from django.utils.translation import gettext_lazy as _

from escriptorium.settings import *
from htr2hpc.settings import *


# DEBUG = True

# enable french and german
LANGUAGES = [
    ('en', _('English')),
    ('fr', _('French')),
    ('de', _('German'))
]

# disables cache for dev env
# CACHES = {
#     'default': {
#         'BACKEND': 'django.core.cache.backends.dummy.DummyCache',
#     }
# }

CSRF_TRUSTED_ORIGINS = ["https://*.princeton.edu", "http://localhost:8000"]

{% endblock %}
{% block celery_task_routes %}
# Celery task routing — directs each task type to the appropriate worker queue
CELERY_TASK_ROUTES = {
    'core.tasks.recalculate_masks': {'queue': 'live'},
    'core.tasks.generate_part_thumbnails': {'queue': 'low-priority'},
    'core.tasks.train': {'queue': 'gpu'},
    'core.tasks.segtrain': {'queue': 'gpu'},
    'core.tasks.align': {'queue': 'jvm'},
    'imports.tasks.*': {'queue': 'low-priority'},
    'users.tasks.async_email': {'queue': 'low-priority'},
    'htr2hpc.tasks.train': {'queue': 'gpu'},
    'htr2hpc.tasks.segtrain': {'queue': 'gpu'},
    'htr2hpc.tasks.hpc_user_setup': {'queue': 'gpu'},
}
{% endblock %}
{% block db_config %}
DATABASES = {
    "default": {
        "ENGINE": "django.db.backends.{{ django_db_backend }}",
        "NAME": "{{ django_db_name }}",
        "USER": "{{ django_db_user }}",
        "PASSWORD": "{{ django_db_password }}",
        "HOST": "{{ django_db_host }}",
    },
}
{% endblock %}
{% block email_config %}
# Email configuration (error messages, admin notifications)
# https://docs.djangoproject.com/en/dev/howto/error-reporting/
ADMINS = [("CDH Dev Team", "cdhdevteam@princeton.edu")]
SERVER_EMAIL = "cdhdevteam@princeton.edu"
# eScriptorium uses a non-standard from email configuration; use same for now
DEFAULT_FROM_EMAIL = SERVER_EMAIL
# use PUL pony express relay
EMAIL_HOST = "lib-ponyexpr-prod.princeton.edu"
EMAIL_SUBJECT_PREFIX = "{{ django_email_subject }}"
EMAIL_USE_TLS = False
#EMAIL_PORT = 587  # use default 25
{% endblock %}
{% block logging_config %}
# Logging configuration
# https://docs.djangoproject.com/en/dev/topics/logging/
# Solution following https://stackoverflow.com/a/9541647
# Sends a logging email even when DEBUG is on
LOGGING = {
    'version': 1,
    'disable_existing_loggers': False,
    'formatters': {
        'basic': {
            'format': '[%(asctime)s] %(levelname)s:%(name)s::%(message)s',
            'datefmt': '%d/%b/%Y %H:%M:%S',
        },
    },
    'handlers': {
        'mail_admins': {
            'level': 'ERROR',
            'class': 'django.utils.log.AdminEmailHandler',
            'include_html': True
        },
        # This configuration lets logrotate and its proper permissions #
        # handle this problem #
        'debug_log': {
            'level': 'DEBUG',
            'class': 'logging.handlers.WatchedFileHandler',
            'filename': '{{ django_logging_path }}',
            'formatter': 'basic',
        }
    },
    'loggers': {
        'django.request': {
            'handlers': ['mail_admins', 'debug_log'],
            'level': 'ERROR',
            'propagate': True,
        },
        '{{ django_app }}': {
            'handlers': ['debug_log'],
            ## 'level': {% if runtime_env == "staging" %}'DEBUG'{% else %}'WARN'{% endif %},
            'level': 'WARN',
            'propagate': True,
        },
        'htr2hpc': {
            'handlers': ['debug_log'],
            'level': 'DEBUG',
            'propagate': False,
        },
    }
}
{% endblock %}
{% block extra_config %}
# custom config for htr2hpc
HPC_HOSTNAME = "{{ hpc_hostname }}"
# copied in place by escriptorium_setup role
HPC_SSH_KEYFILE = "/home/{{ deploy_user }}/.ssh/htr2hpc_id_ed25519"


{% endblock %}
