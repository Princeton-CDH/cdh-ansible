{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "customManagers:dockerfileVersions"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep the supported Python version managed manually",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Keep devbox Python on the supported 3.12 series",
      "matchManagers": ["devbox"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.13"
    },
    {
      "description": ".python-version names only the 3.12 series; devbox supplies the patch release, and pinning one devbox lacks breaks uv sync",
      "matchManagers": ["pyenv"],
      "enabled": false
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "bump"
    }
  ]
}
