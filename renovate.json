{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "customManagers:dockerfileVersions"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep the supported Python version managed manually",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Keep .python-version and devbox Python on the supported 3.12 series",
      "matchManagers": ["pyenv", "devbox"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.13"
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Only propose ansible-core releases the pinned ansible package can install (ansible 12.x requires ansible-core 2.19.x); raise this when bumping ansible's major version",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["ansible-core"],
      "ignoreUnstable": true,
      "allowedVersions": "<2.20"
    }
  ]
}
